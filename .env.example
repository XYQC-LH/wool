# Nexus API Gateway 环境配置
# 复制此文件为 .env 并根据需要修改配置
#
# ============================================
# 开发环境说明
# ============================================
# 本地开发模式（推荐）：
#   - 运行 dev-start.bat 一键启动所有服务
#   - 后端服务（PostgreSQL、Redis、API、Resource-Pool）运行在 Docker 中
#   - 前端服务（frontend-user、frontend-admin）运行在本地 Windows 环境
#   - 自动打开浏览器访问 http://localhost:3000 和 http://localhost:3001
#
# 生产模式：
#   - 运行 start.bat 选择生产模式
#   - 所有服务（包括前端）都运行在 Docker 中
#

# ============================================
# 数据库配置
# ============================================
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=nexus_api
DB_PORT=5432

# ============================================
# Redis 配置
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# API 服务配置
# ============================================
API_PORT=8080
SERVER_MODE=release

# ============================================
# 监控配置（Prometheus / Grafana）
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ============================================
# JWT 配置
# ============================================
# 生产环境请务必修改此密钥！
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE_HOURS=24

# ============================================
# 网关限流与租户配额
# ============================================
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
RATE_LIMIT_IP_RPM=100
RATE_LIMIT_USER_RPM=60
RATE_LIMIT_TENANT_RPM=600
RATE_LIMIT_TENANT_DAILY_REQUESTS=100000
# 0 表示不限制租户日预算（单位：货币金额）
RATE_LIMIT_TENANT_DAILY_COST=0

# ============================================
# 管理员账号（首次启动时自动创建）
# ============================================
# 推荐（同时支持开发/线上）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
ADMIN_EMAIL=admin@example.com

# ============================================
# 资源池配置
# ============================================
RESOURCE_POOL_PORT=8090
RESOURCE_POOL_LOG_LEVEL=INFO
# api 容器内部访问 resource-pool 的地址（docker compose 网络内）
RESOURCE_POOL_URL=http://resource-pool:8000
RESOURCE_POOL_TIMEOUT=600

# ============================================
# 异步作业 Worker 配置（generation_tasks）
# ============================================
JOB_WORKER_POLL_SECONDS=2
JOB_WORKER_BATCH_SIZE=5
JOB_WORKER_CONCURRENCY=2
JOB_WORKER_STALE_SECONDS=900

# ============================================
# 指标聚合 Worker 配置（provider_metrics）
# ============================================
METRICS_WORKER_POLL_SECONDS=60
METRICS_WORKER_LOOKBACK_SECONDS=600

# ============================================
# 前端配置
# ============================================
FRONTEND_USER_PORT=3000
FRONTEND_ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8080

# ============================================
# 存储配置
# ============================================
# 存储驱动: local 或 oss
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/data/objects
STORAGE_SIGN_SECRET=

# ============================================
# OSS 配置 (可选，当 STORAGE_DRIVER=oss 时需要)
# ============================================
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=wool-good
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
OSS_SIGN_EXPIRE_SECONDS=900

# ============================================
# 模型 API 配置
# ============================================
# Sora2 视频生成 API
SORA2_API_HOST=
SORA2_API_KEY=

# Banana 图片生成 API
BANANA_API_HOST=
BANANA_API_KEY=

# Seedream 图片生成 API
SEEDREAM_BASE_URL=
SEEDREAM_API_KEY=

# ============================================
# Jimeng 号池配置 (可选)
# ============================================
# SQLite DB 路径（容器内建议放 /app/data 下以持久化）
JIMENG_POOL_DB_PATH=/app/data/jimeng_pool.db
JIMENG_CREDIT_CACHE_SECONDS=60
JIMENG_ACCOUNT_COOLDOWN_SECONDS=60
# 号池基础配置 JSON（可覆盖超时/ratio/models 等，留空则使用内置默认值）
JIMENG_BASE_CONFIG_JSON=
