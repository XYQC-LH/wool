# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=nexus_api
DB_SSL_MODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE_HOURS=24
JWT_ISSUER=nexus-api

# Rate Limit Configuration
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10
RATE_LIMIT_IP_RPM=100
RATE_LIMIT_USER_RPM=60
RATE_LIMIT_TENANT_RPM=600
RATE_LIMIT_TENANT_DAILY_REQUESTS=100000
# 0 表示不限制租户日预算（单位：货币金额）
RATE_LIMIT_TENANT_DAILY_COST=0

# Storage Driver
# local: store files on local disk (recommended for local/dev)
# oss: store files on Alibaba Cloud OSS
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/objects
# Optional: secret for local signed URLs (defaults to JWT_SECRET)
STORAGE_SIGN_SECRET=

# OSS (Alibaba Cloud Object Storage Service) - used when STORAGE_DRIVER=oss
# Endpoint: oss-cn-shenzhen.aliyuncs.com
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=wool-good
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional: custom/CNAME domain (keep bucket private, use signed URLs)
OSS_PUBLIC_BASE_URL=https://wool-good.cn-shenzhen.taihangwkz.cn
# Signed URL expiration (seconds)
OSS_SIGN_EXPIRE_SECONDS=900

# Default Admin Account Configuration
# 默认管理员账号配置（首次启动时自动创建）
# 推荐：ADMIN_*（同时兼容 DEFAULT_ADMIN_*）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_EMAIL=admin@example.com

# 兼容旧变量名（仍支持）
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin123456
# DEFAULT_ADMIN_EMAIL=admin@example.com
